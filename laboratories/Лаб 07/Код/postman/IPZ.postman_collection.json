              "pm.test('JSON response', function () { pm.response.to.be.json; });"
            ]
          }
        }
      ]
    },
    {
      "name": "Authenticated profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('JSON response', function () { pm.response.to.be.json; });",
              "pm.test('Own email', () => pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('run_email')));"
            ]
          }
        }
      ]
    },
    {
