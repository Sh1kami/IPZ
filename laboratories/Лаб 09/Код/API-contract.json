{
  "contractVersion": "1.0.0",
  "status": "frozen",
  "variant": 26,
  "subject": "Сервіс пошуку роботи",
  "source": "https://mdl.kntu.net.ua/mod/page/view.php?id=247761",
  "implementationChoices": "Endpoint names, roles, limits and HTTP semantics below are explicit educational application decisions, not extra requirements claimed from Moodle.",
  "defaultBaseUrl": "http://127.0.0.1:18726",
  "mainClass": "ua.edu.kntu.jobs.JobPortalServer",
  "database": "SQLite; separate file per run/test; foreign keys enabled; persistence survives restart",
  "auth": {
    "roles": ["SEEKER", "EMPLOYER"],
    "registrationDoesNotLogin": true,
    "cookieName": "JSESSION",
    "cookieAttributes": ["HttpOnly", "SameSite=Strict", "Path=/"],
    "sessionLifetimeHours": 8,
    "passwordStorage": "PBKDF2WithHmacSHA256, 600000 iterations, random 16-byte salt, 256-bit derived key",
    "sessionStorage": "SHA-256 digest of random 32-byte token; raw token is sent only as cookie",
    "unauthenticatedStatus": 401,
    "wrongRoleStatus": 403
  },
  "validation": {
    "lengthCounting": "Unicode code points after trimming, except password (never trimmed)",
    "name": {"min": 2, "max": 80},
    "email": {"max": 254, "normalization": "trim and lowercase Locale.ROOT", "pattern": "^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+$"},
    "password": {"min": 8, "max": 128},
    "resumeTitle": {"min": 5, "max": 120},
    "resumeText": {"min": 20, "max": 10000},
    "resumeSkills": {"min": 0, "max": 1000, "default": ""},
    "jobTitle": {"min": 5, "max": 120},
    "company": {"min": 2, "max": 120},
    "city": {"min": 2, "max": 80},
    "jobDescription": {"min": 20, "max": 10000},
    "salary": {"type": "integer UAH", "min": 1, "max": 1000000},
    "remote": {"type": "boolean", "requiredForCreate": true},
    "coverLetter": {"min": 0, "max": 2000, "default": ""},
    "json": "JSON object, strict string/boolean/integer types; UTF-8; maximum body 65536 bytes; application/json required for JSON endpoints",
    "ids": "positive integer; malformed id -> 400; well-formed missing id -> 404"
  },
  "entities": {
    "user": {"id": "integer", "name": "string", "email": "normalized string", "role": "SEEKER|EMPLOYER", "createdAt": "ISO-8601 UTC string"},
    "resume": {"userId": "integer", "title": "string", "text": "string", "skills": "string", "updatedAt": "ISO-8601 UTC string"},
    "job": {"id": "integer", "ownerId": "integer", "title": "string", "company": "string", "city": "string", "salary": "integer", "remote": "boolean", "description": "string", "status": "ACTIVE|CLOSED", "createdAt": "ISO-8601 UTC string"},
    "application": {"id": "integer", "jobId": "integer", "seekerId": "integer", "coverLetter": "string", "resumeTitle": "snapshot string", "resumeText": "snapshot string", "resumeSkills": "snapshot string", "createdAt": "ISO-8601 UTC string", "jobTitle": "string", "company": "string"},
    "error": {"error": {"code": "stable string", "message": "human-readable Ukrainian string"}}
  },
  "endpoints": [
    {"method": "GET", "path": "/api/health", "auth": "public", "success": {"status": 200, "body": {"status": "ok", "variant": 26}}},
    {"method": "POST", "path": "/api/auth/register", "auth": "public", "body": ["name", "email", "password", "role"], "success": {"status": 201, "body": "{user: user}"}, "errors": {"400": ["VALIDATION"], "409": ["EMAIL_EXISTS"]}},
    {"method": "POST", "path": "/api/auth/login", "auth": "public", "body": ["email", "password"], "success": {"status": 200, "body": "{user: user}", "headers": "Set-Cookie: JSESSION=<opaque token>; Path=/; HttpOnly; SameSite=Strict"}, "errors": {"400": ["VALIDATION"], "401": ["INVALID_CREDENTIALS"]}},
    {"method": "POST", "path": "/api/auth/logout", "auth": "authenticated", "body": "none", "success": {"status": 200, "body": {"ok": true}, "headers": "expired JSESSION cookie"}, "errors": {"401": ["UNAUTHORIZED"]}},
    {"method": "GET", "path": "/api/me", "auth": "authenticated", "success": {"status": 200, "body": "{user: user}"}, "errors": {"401": ["UNAUTHORIZED"]}},
    {"method": "GET", "path": "/api/me/resume", "auth": "SEEKER", "success": {"status": 200, "body": "{resume: resume}"}, "errors": {"401": ["UNAUTHORIZED"], "403": ["FORBIDDEN"], "404": ["RESUME_NOT_FOUND"]}},
    {"method": "PUT", "path": "/api/me/resume", "auth": "SEEKER", "body": ["title", "text", "skills (optional)"], "success": {"status": 200, "body": "{resume: resume}"}, "behavior": "Upserts only current seeker's resume", "errors": {"400": ["VALIDATION"], "401": ["UNAUTHORIZED"], "403": ["FORBIDDEN"]}},
    {"method": "GET", "path": "/api/jobs", "auth": "public", "query": ["query (0..200 chars)", "city (0..80 chars)", "minSalary (integer 0..1000000)", "remote (true|false)", "status (ACTIVE|CLOSED|ALL; default ACTIVE)"], "behavior": "Filters combine with AND. query is a literal case-insensitive substring of title/company/description. city is exact case-insensitive match after trim. Unicode lowercase Locale.ROOT. minSalary is inclusive. remote omitted means both; false means on-site only. Stable ascending id order. SQL-like wildcard characters are literal, not wildcards.", "success": {"status": 200, "body": "{jobs: [job], count: integer}"}, "errors": {"400": ["VALIDATION"]}},
    {"method": "GET", "path": "/api/jobs/{id}", "auth": "public", "success": {"status": 200, "body": "{job: job}"}, "errors": {"400": ["VALIDATION"], "404": ["JOB_NOT_FOUND"]}},
    {"method": "POST", "path": "/api/jobs", "auth": "EMPLOYER", "body": ["title", "company", "city", "salary", "remote", "description"], "success": {"status": 201, "body": "{job: job}", "headers": "Location: /api/jobs/<id>"}, "behavior": "ownerId from authenticated user; initial status ACTIVE", "errors": {"400": ["VALIDATION"], "401": ["UNAUTHORIZED"], "403": ["FORBIDDEN"]}},
    {"method": "PATCH", "path": "/api/jobs/{id}", "auth": "owning EMPLOYER", "body": ["status (ACTIVE|CLOSED)"], "success": {"status": 200, "body": "{job: job}"}, "behavior": "Only status changes; other fields remain persisted unchanged", "errors": {"400": ["VALIDATION"], "401": ["UNAUTHORIZED"], "403": ["FORBIDDEN"], "404": ["JOB_NOT_FOUND"]}},
    {"method": "POST", "path": "/api/jobs/{id}/applications", "auth": "SEEKER", "body": ["coverLetter (optional)"], "success": {"status": 201, "body": "{application: application}"}, "behavior": "Requires own saved resume and ACTIVE job; unique pair jobId/seekerId; snapshot resume stored at application time", "errors": {"400": ["VALIDATION"], "401": ["UNAUTHORIZED"], "403": ["FORBIDDEN"], "404": ["JOB_NOT_FOUND"], "409": ["RESUME_REQUIRED", "JOB_CLOSED", "DUPLICATE_APPLICATION"]}},
    {"method": "GET", "path": "/api/me/applications", "auth": "SEEKER", "success": {"status": 200, "body": "{applications: [application], count: integer}"}, "behavior": "Only current seeker's applications, ascending id", "errors": {"401": ["UNAUTHORIZED"], "403": ["FORBIDDEN"]}}
  ],
  "commonErrors": {"400": ["BAD_JSON", "VALIDATION"], "403": ["ORIGIN_NOT_ALLOWED"], "404": ["NOT_FOUND"], "405": ["METHOD_NOT_ALLOWED"], "413": ["BODY_TOO_LARGE"], "415": ["UNSUPPORTED_MEDIA_TYPE"], "500": ["INTERNAL_ERROR"]},
  "securityBoundary": "Local educational app bound only to 127.0.0.1. No external calls. Prepared SQL, escaped DOM text, generic login error, no password/hash in JSON. Mutating requests reject a supplied Origin that differs from bound base URL; command-line API requests without Origin are allowed. Production HTTPS/deployment not claimed.",
  "launch": {"defaultPort": 18726, "portZero": "supported for tests via start(0)", "defaultDatabase": "data/jobs.sqlite", "demo": "--seed creates only synthetic example.test employer and sample vacancies; explicit opt-in"}
}
